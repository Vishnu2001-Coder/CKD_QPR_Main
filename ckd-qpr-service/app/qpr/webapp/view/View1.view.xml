<mvc:View
    xmlns="sap.f"
    xmlns:m="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:sfb="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    controllerName="qpr.controller.View1"
    height="100%">


    <!-- ================================================= -->
    <!-- CUSTOM NAVY HEADER (ShellBar) -->
    <!-- ================================================= -->

    <!-- <ShellBar
        id="qprShellBar"
        class="qprShellBar"
        title="Create QPR – Quality Product Report"
        homeIcon="sap-icon://sap-logo"
        showSearch="true"
        showNotifications="true"
         /> -->

    <ShellBar
        id="qprShellBar"
        class="qprShellBar"
        homeIcon="img/sap_logo.png"
        homeIconTooltip="SAP"
        title="Create QPR – Quality Product Report"
        showSearch="true"
        showNotifications="true"
    />
    <DynamicPage
        id="dynamicPage"
        fitContent="true">

        <!-- ================================================= -->
        <!-- PAGE TITLE -->
        <!-- ================================================= -->

        <title>
            <DynamicPageTitle>

                <heading>
                    <m:Title
                        text="General Information"
                        level="H2" />
                </heading>

            </DynamicPageTitle>
        </title>


        <!-- ================================================= -->
        <!-- FILTER BAR -->
        <!-- ================================================= -->

        <header>

            <DynamicPageHeader>

                <sfb:SmartFilterBar
                    id="smartFilterBar"
                    entitySet="QPRs"
                    persistencyKey="QPRFilterBar"
                    showGoOnFB="true"
                    useToolbar="false"
                     search=".onGo">                                          <!--Manually set the event -->

                    <sfb:controlConfiguration>

                        <!-- Invoice Number -->
                        <sfb:ControlConfiguration
                            key="invoiceNo"
                            label="Invoice Number"
                            visibleInAdvancedArea="true"
                            mandatory="mandatory">
                            <sfb:customControl>                                    <!-- combo box for value List-->
                                <m:ComboBox
                                    id="invoiceCombo"
                                    items="{ckd>/Invoices}"
                                    selectedKey="{invoiceNo}"
                                    selectionChange=".onInvoiceFilterChange">
                                    <core:Item
                                        key="{ckd>ID}"
                                        text="{ckd>invoiceNo}" />                     <!-- key important like binding
                                                                                      context --> <!-- text which is show the Ui
                                                                                     ,after select user , we getting a value based key -->
                                </m:ComboBox>
                            </sfb:customControl>
                        </sfb:ControlConfiguration>

                        <sfb:ControlConfiguration
                            key="salesOrder"
                            label="Sales Order"
                            visibleInAdvancedArea="true"
                            mandatory="mandatory">
                            <sfb:customControl>
                                <m:Input value="{FilterData>/salesOrderNo}" editable="false" />    <!-- input to
                                get the user input-->
                            </sfb:customControl>
                        </sfb:ControlConfiguration>

                        <sfb:ControlConfiguration
                            key="dateOfContainerReceipt"
                            label="Date of Container Receipt"
                            visibleInAdvancedArea="true"
                           >
                            <sfb:customControl>
                                <m:DatePicker value="{FilterData>/recieptDate}" editable="true" />    <!--
                                input to get the user input-->
                            </sfb:customControl>
                        </sfb:ControlConfiguration>

                        <sfb:ControlConfiguration
                            key="unpackingDate"
                            label="Unpacking Date"
                            visibleInAdvancedArea="true"
                           >
                            <sfb:customControl>
                                <m:DatePicker value="{FilterData>/unpackedDate}" editable="true" />    <!--
                                input to get the user input-->
                            </sfb:customControl>
                        </sfb:ControlConfiguration>


                        <sfb:ControlConfiguration
                            key="assembler"
                            label="Assembler Name"
                            visibleInAdvancedArea="true"
                           >
                            <sfb:customControl>
                                <m:Input value="{FilterData>/assemblerName}" editable="false" />    <!--
                                input to get the user input-->
                            </sfb:customControl>
                        </sfb:ControlConfiguration>


                        <sfb:ControlConfiguration
                            key="country"
                            label="Country"
                            visibleInAdvancedArea="true">
                            <sfb:customControl>
                                <m:Input value="{FilterData>/country}" editable="false" />    <!--
                                input to get the user input-->
                            </sfb:customControl>
                        </sfb:ControlConfiguration>


                        <sfb:ControlConfiguration
                            key="department"
                            label="Department"
                            visibleInAdvancedArea="true"
                           >
                            <sfb:customControl>

                                <m:ComboBox
                                    id="departmentCombo"
                                    items="{ckd>/Department}"
                                    selectedKey="{departmentName}">

                                    <core:Item
                                        key="{ckd>ID}"
                                        text="{ckd>departmentName}" />
                                </m:ComboBox>
                            </sfb:customControl>
                        </sfb:ControlConfiguration>

                        <sfb:ControlConfiguration
                            key="plant"
                            label="Plant"
                            visibleInAdvancedArea="true"
                           >
                            <sfb:customControl>

                                <m:ComboBox
                                    id="plantCombo"
                                    items="{ckd>/Plants}"
                                    selectedKey="{plantName}">

                                    <core:Item
                                        key="{ckd>ID}"
                                        text="{ckd>plantName}" />

                                </m:ComboBox>
                            </sfb:customControl>
                        </sfb:ControlConfiguration>

                    </sfb:controlConfiguration>

                </sfb:SmartFilterBar>

            </DynamicPageHeader>

        </header>
        <content>

            <m:ScrollContainer
                width="100%"
                horizontal="true"
                vertical="false">

                <m:Table id="QPRs" items="{QPRItems>/items}" mode="SingleSelectLeft" growing="true"
                    growingScrollToLoad="true" inset="false">                    <!-- mode : SingleselectLeft/
                MultiSelect-->

                    <m:headerToolbar>
                        <m:Toolbar>
                            <m:Title text="QPR Line Items " />

                            <m:ToolbarSpacer />

                            <m:Button text="Save All Changes" icon="sap-icon://save"
                                press=".onSaveAll" />
                        </m:Toolbar>
                    </m:headerToolbar>

                    <m:columns>

                        <m:Column width="120px">
                            <m:Text text="Model Family" />
                        </m:Column>

                        <m:Column width="150px">
                            <m:Text text="Model Group" />
                        </m:Column>

                        <m:Column width="120px">
                            <m:Text text="Case Number" />
                        </m:Column>

                        <m:Column width="120px">
                            <m:Text text="Hu Number" />
                        </m:Column>

                        <m:Column width="120px">
                            <m:Text text="Part No" />
                        </m:Column>

                        <m:Column width="120px">
                            <m:Text text="Description" />
                        </m:Column>

                        <m:Column width="120px">
                            <m:Text text="Quantity" />
                        </m:Column>

                        <m:Column width="120px">
                            <m:Text text="Part Condition" />
                        </m:Column>

                        <m:Column width="120px">
                            <m:Text text="Packaging Condition" />
                        </m:Column>

                        <m:Column width="120px">
                            <m:Text text="Nature Of Defect" />
                        </m:Column>

                        <m:Column width="120px">
                            <m:Text text="Replacement Or Rework" />
                        </m:Column>

                        <m:Column width="120px">
                            <m:Text text="Attachments" />
                        </m:Column>


                    </m:columns>

                    <m:items>

                        <m:ColumnListItem>

                            <m:cells>

                                <!-- Vehicle ID -->
                                <m:Text text="{QPRItems>modelFamily}" />

                                <!-- Vehicle Name -->
                                <m:Text text="{QPRItems>modelGroup}" />

                                <!-- State -->
                                <m:Text text="{QPRItems>caseNumber}" />

                                <m:Text text="{QPRItems>huNumber}" />

                                <!-- Vehicle Name -->
                                <m:Text text="{QPRItems>partNo}" />

                                <!-- State -->
                                <m:Text text="{QPRItems>description}" />

                                <!-- Vehicle ID -->
                                <m:Text text="{QPRItems>quantity}" />

                                <!-- Vehicle Name -->
                                <m:Text text="{QPRItems>partCondition}" />

                                <!-- State -->
                                <m:Text text="{QPRItems>packagingCondition}" />

                                <m:Text text="{QPRItems>natureOfDefect}" />

                                <!-- Vehicle Name -->
                                <m:Text text="{QPRItems>replacementOrRework}" />

                                <!-- State -->
                                <m:Text text="{QPRItems>state}" />


                            </m:cells>

                        </m:ColumnListItem>

                    </m:items>

                </m:Table>
            </m:ScrollContainer>
        </content>

    </DynamicPage>

</mvc:View>