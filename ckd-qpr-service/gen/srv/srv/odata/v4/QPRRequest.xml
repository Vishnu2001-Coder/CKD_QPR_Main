<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
    <edmx:Include Alias="Common" Namespace="com.sap.vocabularies.Common.v1"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Alias="Core" Namespace="Org.OData.Core.V1"/>
  </edmx:Reference>
  <edmx:DataServices>
    <Schema Namespace="QPRRequest" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <Annotation Term="Core.Links">
        <Collection>
          <Record>
            <PropertyValue Property="rel" String="author"/>
            <PropertyValue Property="href" String="https://cap.cloud.sap"/>
          </Record>
        </Collection>
      </Annotation>
      <EntityContainer Name="EntityContainer">
        <EntitySet Name="QPRs" EntityType="QPRRequest.QPRs">
          <NavigationPropertyBinding Path="items" Target="QPRItems"/>
        </EntitySet>
        <EntitySet Name="QPRItems" EntityType="QPRRequest.QPRItems">
          <NavigationPropertyBinding Path="qpr" Target="QPRs"/>
          <NavigationPropertyBinding Path="attachments" Target="QPRAttachments"/>
        </EntitySet>
        <EntitySet Name="QPRAttachments" EntityType="QPRRequest.QPRAttachments">
          <NavigationPropertyBinding Path="qprItem" Target="QPRItems"/>
        </EntitySet>
      </EntityContainer>
      <EntityType Name="QPRs">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="qprNumber" Type="Edm.String" MaxLength="30"/>
        <Property Name="invoice" Type="Edm.String" MaxLength="100"/>
        <Property Name="salesOrder" Type="Edm.String" MaxLength="100"/>
        <Property Name="dateOfContainerReceipt" Type="Edm.Date"/>
        <Property Name="unpackingDate" Type="Edm.Date"/>
        <Property Name="assembler" Type="Edm.String" MaxLength="100"/>
        <Property Name="country" Type="Edm.String" MaxLength="100"/>
        <Property Name="department" Type="Edm.String" MaxLength="100"/>
        <Property Name="plant" Type="Edm.String" MaxLength="50"/>
        <Property Name="status" Type="Edm.String" MaxLength="30"/>
        <NavigationProperty Name="items" Type="Collection(QPRRequest.QPRItems)" Partner="qpr">
          <OnDelete Action="Cascade"/>
        </NavigationProperty>
      </EntityType>
      <EntityType Name="QPRItems">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <NavigationProperty Name="qpr" Type="QPRRequest.QPRs" Partner="items">
          <ReferentialConstraint Property="qpr_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <Property Name="qpr_ID" Type="Edm.Guid"/>
        <Property Name="modelFamily" Type="Edm.String"/>
        <Property Name="modelGroup" Type="Edm.String"/>
        <Property Name="hu" Type="Edm.String"/>
        <Property Name="part" Type="Edm.String"/>
        <Property Name="description" Type="Edm.String"/>
        <Property Name="caseNumber" Type="Edm.String" MaxLength="50"/>
        <Property Name="Quantity" Type="Edm.Decimal" Precision="13" Scale="3"/>
        <Property Name="uom" Type="Edm.String" MaxLength="10"/>
        <Property Name="partCondition" Type="Edm.String" MaxLength="50"/>
        <Property Name="packagingCondition" Type="Edm.String" MaxLength="50"/>
        <Property Name="natureOfDefect" Type="Edm.String" MaxLength="100"/>
        <Property Name="replacementOrRework" Type="Edm.String" MaxLength="30"/>
        <NavigationProperty Name="attachments" Type="Collection(QPRRequest.QPRAttachments)" Partner="qprItem">
          <OnDelete Action="Cascade"/>
        </NavigationProperty>
      </EntityType>
      <EntityType Name="QPRAttachments">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <NavigationProperty Name="qprItem" Type="QPRRequest.QPRItems" Partner="attachments">
          <ReferentialConstraint Property="qprItem_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <Property Name="qprItem_ID" Type="Edm.Guid"/>
        <Property Name="fileName" Type="Edm.String" MaxLength="255"/>
        <Property Name="fileType" Type="Edm.String" MaxLength="100"/>
        <Property Name="fileContent" Type="Edm.Stream"/>
      </EntityType>
      <Annotations Target="QPRRequest.QPRs/ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="QPRRequest.QPRItems/ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="QPRRequest.QPRAttachments/ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="QPRRequest.QPRAttachments/fileContent">
        <Annotation Term="Core.MediaType" Path="fileType"/>
      </Annotations>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>