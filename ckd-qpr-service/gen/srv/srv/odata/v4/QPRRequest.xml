        <Property Name="partName" Type="Edm.String" MaxLength="150"/>
        <Property Name="quantity" Type="Edm.Int32" DefaultValue="1"/>
        <Property Name="huContainer_ID" Type="Edm.Guid" Nullable="false"/>
      </EntityType>
