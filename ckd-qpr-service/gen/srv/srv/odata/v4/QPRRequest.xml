          <NavigationPropertyBinding Path="part" Target="Parts"/>
          <NavigationPropertyBinding Path="attachments" Target="QPRAttachments"/>
        </EntitySet>
        <EntitySet Name="QPRAttachments" EntityType="QPRRequest.QPRAttachments">
          <NavigationPropertyBinding Path="qprItem" Target="QPRItems"/>
        </EntitySet>
        <EntitySet Name="ModelFamilies" EntityType="QPRRequest.ModelFamilies"/>
        <EntitySet Name="Parts" EntityType="QPRRequest.Parts"/>
