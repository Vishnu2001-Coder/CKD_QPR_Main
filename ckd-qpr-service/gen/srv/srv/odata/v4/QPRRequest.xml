        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <NavigationProperty Name="qpr" Type="QPRRequest.QPRs" Partner="items">
          <ReferentialConstraint Property="qpr_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <Property Name="qpr_ID" Type="Edm.Guid"/>
