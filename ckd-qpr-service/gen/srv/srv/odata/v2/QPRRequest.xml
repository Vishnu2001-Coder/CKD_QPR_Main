        <Property Name="qprItem_ID" Type="Edm.Guid"/>
        <Property Name="fileName" Type="Edm.String" MaxLength="255"/>
        <Property Name="fileType" Type="Edm.String" MaxLength="100"/>
      </EntityType>
      <Association Name="QPRItems_qpr">
        <End Role="QPRItems" Type="QPRRequest.QPRItems" Multiplicity="*"/>
        <End Role="QPRs" Type="QPRRequest.QPRs" Multiplicity="0..1">
          <OnDelete Action="Cascade"/>
        </End>
        <ReferentialConstraint>
          <Principal Role="QPRs">
            <PropertyRef Name="ID"/>
          </Principal>
          <Dependent Role="QPRItems">
            <PropertyRef Name="qpr_ID"/>
          </Dependent>
        </ReferentialConstraint>
      </Association>
      <Association Name="QPRAttachments_qprItem">
        <End Role="QPRAttachments" Type="QPRRequest.QPRAttachments" Multiplicity="*"/>
        <End Role="QPRItems" Type="QPRRequest.QPRItems" Multiplicity="0..1">
          <OnDelete Action="Cascade"/>
        </End>
        <ReferentialConstraint>
          <Principal Role="QPRItems">
            <PropertyRef Name="ID"/>
          </Principal>
          <Dependent Role="QPRAttachments">
            <PropertyRef Name="qprItem_ID"/>
          </Dependent>
        </ReferentialConstraint>
      </Association>
      <Annotations Target="QPRRequest.QPRs/ID" xmlns="http://docs.oasis-open.org/odata/ns/edm">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="QPRRequest.QPRItems/ID" xmlns="http://docs.oasis-open.org/odata/ns/edm">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="QPRRequest.QPRAttachments" xmlns="http://docs.oasis-open.org/odata/ns/edm">
        <Annotation Term="Core.MediaType" Path="fileType"/>
      </Annotations>
      <Annotations Target="QPRRequest.QPRAttachments/ID" xmlns="http://docs.oasis-open.org/odata/ns/edm">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>