<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata" xmlns:sap="http://www.sap.com/Protocols/SAPData">
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
    <edmx:Include Alias="Common" Namespace="com.sap.vocabularies.Common.v1"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Core.V1.xml" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
    <edmx:Include Alias="Core" Namespace="Org.OData.Core.V1"/>
  </edmx:Reference>
  <edmx:DataServices m:DataServiceVersion="2.0">
    <Schema Namespace="QPRRequest" xmlns="http://schemas.microsoft.com/ado/2008/09/edm">
      <Annotation Term="Core.Links" xmlns="http://docs.oasis-open.org/odata/ns/edm">
        <Collection>
          <Record>
            <PropertyValue Property="rel" String="author"/>
            <PropertyValue Property="href" String="https://cap.cloud.sap"/>
          </Record>
        </Collection>
      </Annotation>
      <EntityContainer Name="EntityContainer" m:IsDefaultEntityContainer="true">
        <EntitySet Name="QPRs" EntityType="QPRRequest.QPRs"/>
        <EntitySet Name="QPRItems" EntityType="QPRRequest.QPRItems"/>
        <EntitySet Name="QPRAttachments" EntityType="QPRRequest.QPRAttachments"/>
        <AssociationSet Name="QPRItems_qpr" Association="QPRRequest.QPRItems_qpr">
          <End Role="QPRItems" EntitySet="QPRItems"/>
          <End Role="QPRs" EntitySet="QPRs"/>
        </AssociationSet>
        <AssociationSet Name="QPRAttachments_qprItem" Association="QPRRequest.QPRAttachments_qprItem">
          <End Role="QPRAttachments" EntitySet="QPRAttachments"/>
          <End Role="QPRItems" EntitySet="QPRItems"/>
        </AssociationSet>
      </EntityContainer>
      <EntityType Name="QPRs">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="qprNumber" Type="Edm.String" MaxLength="30"/>
        <Property Name="invoice" Type="Edm.String" MaxLength="100"/>
        <Property Name="salesOrder" Type="Edm.String" MaxLength="100"/>
        <Property Name="dateOfContainerReceipt" Type="Edm.DateTime" sap:display-format="Date"/>
        <Property Name="unpackingDate" Type="Edm.DateTime" sap:display-format="Date"/>
        <Property Name="assembler" Type="Edm.String" MaxLength="100"/>
        <Property Name="country" Type="Edm.String" MaxLength="100"/>
        <Property Name="department" Type="Edm.String" MaxLength="100"/>
        <Property Name="plant" Type="Edm.String" MaxLength="50"/>
        <Property Name="status_1" Type="Edm.String" MaxLength="30"/>
        <Property Name="status_2" Type="Edm.String" MaxLength="30"/>
        <Property Name="status_3" Type="Edm.String" MaxLength="30"/>
        <Property Name="status_4" Type="Edm.String" MaxLength="30"/>
        <NavigationProperty Name="items" Relationship="QPRRequest.QPRItems_qpr" FromRole="QPRs" ToRole="QPRItems"/>
      </EntityType>
      <EntityType Name="QPRItems">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <NavigationProperty Name="qpr" Relationship="QPRRequest.QPRItems_qpr" FromRole="QPRItems" ToRole="QPRs"/>
        <Property Name="qpr_ID" Type="Edm.Guid"/>
        <Property Name="modelFamily" Type="Edm.String"/>
        <Property Name="modelGroup" Type="Edm.String"/>
        <Property Name="hu" Type="Edm.String"/>
        <Property Name="part" Type="Edm.String"/>
        <Property Name="description" Type="Edm.String"/>
        <Property Name="caseNumber" Type="Edm.String" MaxLength="50"/>
        <Property Name="Quantity" Type="Edm.Int32"/>
        <Property Name="uom" Type="Edm.String" MaxLength="10"/>
        <Property Name="partCondition" Type="Edm.String" MaxLength="50"/>
        <Property Name="packagingCondition" Type="Edm.String" MaxLength="50"/>
        <Property Name="natureOfDefect" Type="Edm.String" MaxLength="100"/>
        <Property Name="replacementOrRework" Type="Edm.String" MaxLength="30"/>
        <NavigationProperty Name="attachments" Relationship="QPRRequest.QPRAttachments_qprItem" FromRole="QPRItems" ToRole="QPRAttachments"/>
      </EntityType>
      <EntityType Name="QPRAttachments" m:HasStream="true">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
