COLUMN TABLE QPR_db_QPRItems (
  ID NVARCHAR(36) NOT NULL,
  qpr_ID NVARCHAR(36),
  modelFamily NVARCHAR(5000),
  modelGroup NVARCHAR(5000),
  hu NVARCHAR(5000),
  part NVARCHAR(5000),
  description NVARCHAR(5000),
  caseNumber NVARCHAR(50),
  Quantity DECIMAL(13, 3),
  uom NVARCHAR(10),
  partCondition NVARCHAR(50),
  packagingCondition NVARCHAR(50),
  natureOfDefect NVARCHAR(100),
  replacementOrRework NVARCHAR(30),
  PRIMARY KEY(ID)
)