VIEW CKDService_Plants AS SELECT
  Plants_0.ID,
  Plants_0.createdAt,
  Plants_0.createdBy,
  Plants_0.modifiedAt,
  Plants_0.modifiedBy,
  Plants_0.plantCode,
  Plants_0.address,
  Plants_0.city,
  Plants_0.state,
  Plants_0.country,
  Plants_0.plantName,
  Plants_0.plantType,
  Plants_0.status
FROM ckd_qpr_db1_Plants AS Plants_0