COLUMN TABLE QPR_db_QPRs (
  ID NVARCHAR(36) NOT NULL,
  qprNumber NVARCHAR(30),
  invoice NVARCHAR(100),
  salesOrder NVARCHAR(100),
  dateOfContainerReceipt DATE,
  unpackingDate DATE,
  assembler NVARCHAR(100),
  country NVARCHAR(100),
  department NVARCHAR(100),
  plant NVARCHAR(50),
  status NVARCHAR(30),
  PRIMARY KEY(ID)
)