VIEW QPRRequest_Department AS SELECT
  Department_0.ID,
  Department_0.createdAt,
  Department_0.createdBy,
  Department_0.modifiedAt,
  Department_0.modifiedBy,
  Department_0.departmentCode,
  Department_0.departmentName,
  Department_0.departmentType,
  Department_0.status,
  Department_0.plant_ID
FROM ckd_qpr_db1_Department AS Department_0