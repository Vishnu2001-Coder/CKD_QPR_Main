{
  "name": "ckd-qpr-service",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.16.1",
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4",
    "dotenv": "^18.0.8",
    "nodemon": "^3.1.14"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "server": {
      "index": true,
      "body_parser": {
        "limit": "20mb"
      }
    },
    "requires": {
      "[development]": {
        "auth": "mocked",
        "users": {
          "lakshmi": {
            "roles": [
              "support"
            ]
          }
        }
      },
      "[production]": {
        "auth": "mocked",
        "users": {
          "lakshmi": {
            "roles": [
              "support"
            ]
          }
        }
      }
    }
  }
}
